# Скопируйте в .env и заполните. docker compose читает .env автоматически.

# Ведущие: telegram_id:Имя:Часовой/Пояс[:ж] через запятую («ж» — женский род в текстах: «готова»). Порядок важен: первый — канал A, второй — канал B.
# Бот отвечает только им; чужому пишет его Telegram ID — так его удобно узнать.
PEOPLE=111111111:Аня:Europe/Lisbon:ж,222222222:Боря:Asia/Tbilisi

# Название подкаста: имя файла «<название> №N.mp3», альбом в тегах.
PODCAST_NAME=мой подкаст

# Номер последнего уже вышедшего выпуска (следующий будет START_N+1).
START_N=0

# Адрес мини-приложения «Синхросигнал» (узел Tailscale с Funnel). Пусто — без синхросигнала.
WEBAPP_URL=

# Часовой пояс логов и дат в именах.
TZ=Europe/Lisbon

# Папка данных на хосте: выпуски, заставки, settings.json, состояние бота.
DATA_DIR=/srv/podcast-data

# Имя узла Tailscale для мини-приложения.
TS_HOSTNAME=podcast-pi

# Группа на хосте, которой доступны папка данных и secrets/ (обычно группа вашего пользователя: `id -g`).
# Бот работает как uid 101 (пользователь локального Bot API) с этой группой — не от root.
HOST_GID=1000

# Канал для автопубликации после одобрения обоих ведущих: @имя_канала или числовой id (-100…).
# Бот должен быть админом канала с правом публиковать. Пусто — бот только напомнит переслать вручную.
PUBLISH_CHAT=
# Свой RSS-фид для площадок (Apple, Spotify, Яндекс…): адрес, по которому снаружи виден веб-сервер бота
# (обычно тот же, что WEBAPP_URL). Пусто — без фида. Шапку и старые выпуски — `python3 feed.py import`.
FEED_URL=
